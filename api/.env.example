# Optional deployment environment variables; not loaded automatically by the application.
# Defaults support the local frontend. Replace origins with exact HTTPS production origins.
REVIEWTRUST_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
REVIEWTRUST_RATE_PER_MINUTE=10
REVIEWTRUST_RATE_BURST=2
REVIEWTRUST_LIMITER_CAPACITY=10000
REVIEWTRUST_MAX_CONCURRENT=2
REVIEWTRUST_TIMEOUT_SECONDS=10
